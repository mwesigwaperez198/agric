# Root environment reference — copy to .env (never commit real values).
# Each workspace documents its own variables in .env.example too.

# Frontend (web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Backend (api/.env)
DATABASE_URL=postgresql+psycopg://farm:farm@localhost:5432/farmfork
SECRET_KEY=change-me-to-a-64-char-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
PLATFORM_COMMISSION_RATE=0.025
# openai-whisper / ElevenLabs keys (optional, mock fallback used when empty)
WHISPER_API_KEY=
ELEVENLABS_API_KEY=
# AI vision provider (openai|anthropic|mock)
VISION_PROVIDER=mock
